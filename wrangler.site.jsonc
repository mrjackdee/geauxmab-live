{
  // © MrJackDee™. All rights reserved.
  // Cloudflare Worker for geauxmab.com news + journal (the site itself stays on Hostinger).
  // It only answers geauxmab.com/api/*, geauxmab.com/journal and geauxmab.com/journal/*; /os and all other paths are untouched.
  // Deploy: npx wrangler deploy -c wrangler.site.jsonc
  // One-time setup: see README_SITE.md (KV namespace, Cloudflare Access, ACCESS_AUD).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "geauxmab-site-api",
  "main": "site-worker/index.ts",
  "compatibility_date": "2026-10-01",
  "kv_namespaces": [
    // Created 2026-10-29 with: npx wrangler kv namespace create JOURNAL -c wrangler.site.jsonc
    { "binding": "JOURNAL", "id": "f2fb337b56af49c78bc4bbe418bf871b" }
  ],
  "vars": {
    "JOURNAL_AUTHOR": "jd@geauxmab.com",
    "SITE_URL": "https://geauxmab.com",
    "ACCESS_TEAM_DOMAIN": "REPLACE_WITH_TEAM.cloudflareaccess.com",
    "ACCESS_AUD": "REPLACE_WITH_ACCESS_APPLICATION_AUD"
  },
  "routes": [
    { "pattern": "geauxmab.com/api/*", "zone_name": "geauxmab.com" },
    { "pattern": "geauxmab.com/journal", "zone_name": "geauxmab.com" },
    { "pattern": "geauxmab.com/journal/*", "zone_name": "geauxmab.com" }
  ]
}
